  {
    "id": "fn_snapshot",
    "type": "function",
    "z": "tab_state",
    "name": "state snapshot",
    "func": "const snapshot = flow.get(\"sentinelSnapshot\") || {};\nconst topic = msg.topic;\n\nsnapshot[topic] = msg.payload;\nsnapshot.last_topic = topic;\nsnapshot.last_seen = new Date().toISOString();\nflow.set(\"sentinelSnapshot\", snapshot);\n\nmsg.payload = {\n    last_topic: topic,\n    last_value: msg.payload,\n    snapshot\n};\n\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 370,
    "y": 250,
    "wires": [["dbg_state"]]
  },
