  {
    "id": "fn_normalize",
    "type": "function",
    "z": "tab_bridge",
    "name": "normalize command",
    "func": "let raw = msg.payload;\nif (Buffer.isBuffer(raw)) {\n    raw = raw.toString(\"utf8\");\n}\n\nconst originalTopic = msg.topic;\n\nif (typeof raw === \"string\") {\n    const trimmed = raw.trim();\n    if (!trimmed) {\n        return null;\n    }\n\n    if ((trimmed.startsWith(\"{\") && trimmed.endsWith(\"}\")) || (trimmed.startsWith(\"[\") && trimmed.endsWith(\"]\"))) {\n        try {\n            raw = JSON.parse(trimmed);\n        } catch (error) {\n            raw = trimmed;\n        }\n    } else {\n        raw = trimmed;\n    }\n}\n\nlet token = null;\nlet meta = null;\n\nif (typeof raw === \"string\") {\n    token = raw;\n} else if (raw && typeof raw === \"object\") {\n    meta = raw;\n    token = raw.value ?? raw.command ?? raw.token ?? raw.text ?? raw.payload ?? null;\n}\n\nif (token === null || token === undefined) {\n    return null;\n}\n\nconst normalized = String(token).trim();\nif (!normalized) {\n    return null;\n}\n\nmsg.topic = \"home/commands\";\nmsg.payload = normalized;\nmsg.original_topic = originalTopic;\nif (meta) {\n    msg.command_meta = meta;\n}\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 120,
    "wires": [["mqtt_commands", "dbg_commands"]]
  },
